# Optional: the app works fully without any of these (it falls back to local, rule-based insights).
# Copy this file to ".env" and fill in a key to enable LLM-written explanations.
# Never commit your real .env file.

# Which provider to use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Set the key for the provider you chose (leave blank to stay in local mode)
ANTHROPIC_API_KEY=your-api-key-here
OPENAI_API_KEY=

# Optional model override (defaults: claude-sonnet-5-5 / gpt-4o-mini)
LLM_MODEL=
